:{$PORT:80} {
    root * /app/public
    encode zstd gzip

    @private path /api/config /api/config/* /database/* /docs/* /tests/* /sources/* /.git/*
    @php path *.php

    route {
        respond @private 404

        handle @php {
            php_server
        }

        handle {
            try_files {path} {path}/index.html
            file_server
        }
    }
}
